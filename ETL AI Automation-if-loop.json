    {
      "parameters": {
        "jsCode": "\nconst items = $input.all();\n\nconst cleanedData = [];\n\nfor (const item of items) {\n    try {\n        // Parse JSON string from AI output\n        let rawData = item.json.text;\n\n        // Remove Markdown code blocks if AI generates them\n        rawData = rawData\n            .replace(/```json/gi, \"\")\n            .replace(/```/g, \"\")\n            .trim();\n\n        const data = JSON.parse(rawData);\n\n        // Clean and standardize fields\n        const cleaned = {\n            Student_ID: String(data.Student_ID || \"\").trim(),\n            Name: String(data.Name || \"\").trim(),\n            Email: String(data.Email || \"\").trim().toLowerCase(),\n            Phone: String(data.Phone || \"\").trim(),\n            Course: String(data.Course || \"\").trim(),\n            Fee_Paid: data.Fee_Paid === true || data.Fee_Paid === \"true\",\n            City: String(data.City || \"\").trim(),\n            Enrolled_Date: String(data.Enrolled_Date || \"\").trim()\n        };\n\n        // Validate email\n        const emailRegex = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/;\n        if (!emailRegex.test(cleaned.Email)) {\n            cleaned.Email = \"\";\n        }\n\n        // Validate phone number (10 digits)\n        if (!/^\\d{10}$/.test(cleaned.Phone)) {\n            cleaned.Phone = \"\";\n        }\n\n        // Validate date (YYYY-MM-DD)\n        const dateRegex = /^\\d{4}-\\d{2}-\\d{2}$/;\n        if (!dateRegex.test(cleaned.Enrolled_Date) ||\n            isNaN(Date.parse(cleaned.Enrolled_Date))) {\n            cleaned.Enrolled_Date = \"\";\n        }\n\n        cleanedData.push({\n            json: cleaned\n        });\n\n    } catch (error) {\n        // Skip invalid JSON records\n        cleanedData.push({\n            json: {\n                error: \"JSON parsing failed\",\n                original_data: item.json.text,\n                details: error.message\n            }\n        });\n    }\n}\n\nreturn cleanedData;\n"
      },
